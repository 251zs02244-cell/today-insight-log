doctype html
html(lang="ja")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1")
        title= title
        link(
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
            rel="stylesheet"
        )
    body
        main.container.py-5
            .d-flex.justify-content-between.align-items-center.mb-4
                h1.mb-0 気付きを編集
                a.btn.btn-outline-secondary(href=`/insights/${insight.id}`) 詳細へ戻る

            form(method="post" action=`/insights/${insight.id}/update`)
                input(type="hidden" name="csrfToken" value=csrfToken)
                .mb-3
                    label.form-label(for="title") タイトル
                    input.form-control(
                        type="text"
                        id="title"
                        name="title"
                        required
                        maxlength="80"
                        value=insight.title
                    )

                .mb-3
                    label.form-label(for="category") カテゴリ
                    select.form-select(id="category" name="category" required)
                        each category in categories
                            option(value=category selected=category === insight.category)= category

                .mb-3
                    label.form-label(for="body") 本文
                    textarea.form-control(
                        id="body"
                        name="body"
                        rows="6"
                        required
                        maxlength="2000"
                    )= insight.body

                button.btn.btn-primary(type="submit") 更新する