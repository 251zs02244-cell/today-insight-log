doctype html
html(lang="ja")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1")
        title= title
        link(
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
            rel="stylesheet"
        )
    body
        main.container.py-5
            .d-flex.justify-content-between.align-items-center.mb-4
                h1.mb-0 気付き一覧
                div
                    a.btn.btn-primary.me-2(href="/insights/new") 新しい気付きを投稿
                    a.btn.btn-outline-secondary(href="/") トップへ戻る

            if insights.length === 0
                .alert.alert-secondary まだ気付きは投稿されていません。
            else
                .row.g-3
                    each insight in insights
                        .col-md-6
                            .card.h-100
                                .card-body
                                    .badge.text-bg-secondary.mb-2= insight.category
                                    h2.h5.card-title= insight.title
                                    p.card-text= insight.body
                                    p.card-text
                                        small.text-body-secondary= insight.createdAt.toLocaleString('ja-JP')