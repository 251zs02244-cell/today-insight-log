doctype html
html(lang="ja")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1")
        title= title
        link(
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
            rel="stylesheet"
        )
    body
        main.container.py-5
            .d-flex.justify-content-between.align-items-center.mb-4
                h1.mb-0 新しい気付きを投稿
                a.btn.btn-outline-secondary(href="/insights") 一覧へ戻る

            form(method="post" action="/insights")
                input(type="hidden" name="csrfToken" value=csrfToken)
                .mb-3
                    label.form-label(for="title") タイトル
                    input.form-control(type="text" id="title" name="title" required maxlength="80")

                .mb-3
                    label.form-label(for="category") カテゴリ
                    select.form-select(id="category" name="category" required)
                        option(value="") 選択してください
                        each category in categories
                            option(value=category)= category

                .mb-3
                    label.form-label(for="body") 本文
                    textarea.form-control(id="body" name="body" rows="6" required maxlength="2000")

                button.btn.btn-primary(type="submit") 投稿する