doctype html
html(lang="ja")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1")
        title= title
        link(
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
            rel="stylesheet"
        )
    body
        main.container.py-5
            .mb-4
                a.btn.btn-outline-secondary(href="/insights") 一覧へ戻る

            .card
                .card-body
                    .badge.text-bg-secondary.mb-3= insight.category
                    h1.card-title.h3= insight.title
                    p.text-body-secondary
                        | 投稿日時：
                        = insight.createdAt.toLocaleString('ja-JP')
                    hr
                    p.card-text(style="white-space: pre-wrap;")= insight.body

                    .mt-4.d-flex.gap-2
                        a.btn.btn-primary(href=`/insights/${insight.id}/edit`) 編集する
                        form(method="post" action=`/insights/${insight.id}/delete`)
                            button.btn.btn-danger(type="submit") 削除する